# Browser-safe Supabase project values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local and preview may use `dummy`. Production health results require `validated`.
ANALYZER_MODE=dummy

# Explicitly enables the dummy analyzer on a hosted product demo. When true,
# SoundCue renders a persistent placeholder-analysis warning. Never use this for
# a clinically presented screening service.
SOUNDCUE_ALLOW_HOSTED_DUMMY=false

# Consent cookie signing. Generate a long random value for deployed environments.
CONSENT_SIGNING_SECRET=
CONSENT_DOCUMENT_VERSION=2026-08-01

# Explicit demo seed inputs. Nothing here should be committed with real values.
SOUNDCUE_DEMO_EMAIL=
SOUNDCUE_DEMO_PASSWORD=
SOUNDCUE_ALLOW_DEMO_SEED=false
